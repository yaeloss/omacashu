#!/usr/bin/python3 -I
"""Launcher for the omaCashu broker. Run with isolated Python (-I): no PYTHON* env, no user site, no cwd on sys.path."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "broker"))

from omacashu_broker.server import main  # noqa: E402

main()
