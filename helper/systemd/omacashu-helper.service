[Unit]
Description=omaCashu wallet helper (budget-limited NWC payments for the Omarchy bar)
Documentation=https://github.com/yaeloss/omacashu

[Service]
Type=simple
ExecStart=@NODE@ --no-warnings @HELPER@/bin/omacashu daemon
Restart=on-failure
RestartSec=3

# %t/omacashu (0700) holds the user-only socket; %S/omacashu (0700) holds the payment ledger.
RuntimeDirectory=omacashu
RuntimeDirectoryMode=0700
StateDirectory=omacashu
StateDirectoryMode=0700
UMask=0077
LimitCORE=0

# Sandboxing. Needs: network (Nostr relays), the session bus (keyring via secret-tool).
# MemoryDenyWriteExecute is deliberately absent: Node's JIT needs it.
NoNewPrivileges=yes
PrivateUsers=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
